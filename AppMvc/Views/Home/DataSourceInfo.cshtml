@model AppMvc.Models.DataSourceInfoViewModel
@{
    ViewData["Title"] = "Overview";
    var wapiDb = Model.WebApiInfo?.Db;
    var localDb = Model.LocalInfo?.Db;
}
<!-- Page web-api-info -->
<div class="container px-4 py-4" id="webapi-info">
    <h2 class="pb-2 border-bottom">Data source information</h2>
    <p>Overview of Friends content in both data sources.</p>
    <p class="small text-body-secondary">Active datasource (used by Friends pages): @Model.ActiveDataSource</p>

    <div class="row row-cols-1 row-cols-lg-2 align-items-stretch g-4 py-5">
        <div class="col">
            <h3 class="fw-bold mb-3 fs-4 text-body-emphasis">WebApi</h3>
            <p class="small text-body-secondary">Note: Friends WebApi is shared remote data; seeding from this app is not supported.</p>

            <div class="row mb-2 text-center">
                <div class="col-md-6 themed-grid-head-col">Entity</div>
                <div class="col-md-3 themed-grid-head-col">Seeded</div>
                <div class="col-md-3 themed-grid-head-col">Unseeded</div>
            </div>

            <div class="row mb-2 text-center">
                <div class="col-md-6 themed-grid-col">Friends</div>
                <div class="col-md-3 themed-grid-col">@(wapiDb?.NrSeededFriends ?? 0)</div>
                <div class="col-md-3 themed-grid-col">@(wapiDb?.NrUnseededFriends ?? 0)</div>
            </div>
            <div class="row mb-2 text-center">
                <div class="col-md-6 themed-grid-col">Addresses</div>
                <div class="col-md-3 themed-grid-col">@(wapiDb?.NrSeededAddresses ?? 0)</div>
                <div class="col-md-3 themed-grid-col">@(wapiDb?.NrUnseededAddresses ?? 0)</div>
            </div>
            <div class="row mb-2 text-center">
                <div class="col-md-6 themed-grid-col">Pets</div>
                <div class="col-md-3 themed-grid-col">@(wapiDb?.NrSeededPets ?? 0)</div>
                <div class="col-md-3 themed-grid-col">@(wapiDb?.NrUnseededPets ?? 0)</div>
            </div>
            <div class="row mb-2 text-center">
                <div class="col-md-6 themed-grid-col">Quotes</div>
                <div class="col-md-3 themed-grid-col">@(wapiDb?.NrSeededQuotes ?? 0)</div>
                <div class="col-md-3 themed-grid-col">@(wapiDb?.NrUnseededQuotes ?? 0)</div>
            </div>

            <a href="~/Friend/ListOfFriends" class="btn btn-primary mt-2">See details</a>
        </div>

        <div class="col">
            <h3 class="fw-bold mb-3 fs-4 text-body-emphasis">Local (in-memory)</h3>
            <p class="small text-body-secondary">This datasource supports seeding from the Seed page when SQLDatabase is selected.</p>

            <div class="row mb-2 text-center">
                <div class="col-md-6 themed-grid-head-col">Entity</div>
                <div class="col-md-3 themed-grid-head-col">Seeded</div>
                <div class="col-md-3 themed-grid-head-col">Unseeded</div>
            </div>

            <div class="row mb-2 text-center">
                <div class="col-md-6 themed-grid-col">Friends</div>
                <div class="col-md-3 themed-grid-col">@(localDb?.NrSeededFriends ?? 0)</div>
                <div class="col-md-3 themed-grid-col">@(localDb?.NrUnseededFriends ?? 0)</div>
            </div>
            <div class="row mb-2 text-center">
                <div class="col-md-6 themed-grid-col">Addresses</div>
                <div class="col-md-3 themed-grid-col">@(localDb?.NrSeededAddresses ?? 0)</div>
                <div class="col-md-3 themed-grid-col">@(localDb?.NrUnseededAddresses ?? 0)</div>
            </div>
            <div class="row mb-2 text-center">
                <div class="col-md-6 themed-grid-col">Pets</div>
                <div class="col-md-3 themed-grid-col">@(localDb?.NrSeededPets ?? 0)</div>
                <div class="col-md-3 themed-grid-col">@(localDb?.NrUnseededPets ?? 0)</div>
            </div>
            <div class="row mb-2 text-center">
                <div class="col-md-6 themed-grid-col">Quotes</div>
                <div class="col-md-3 themed-grid-col">@(localDb?.NrSeededQuotes ?? 0)</div>
                <div class="col-md-3 themed-grid-col">@(localDb?.NrUnseededQuotes ?? 0)</div>
            </div>

            <a href="~/Seed/Seed" class="btn btn-outline-success mt-2">Seed local data</a>
        </div>
    </div>

