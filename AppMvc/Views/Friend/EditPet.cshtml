@model AppMvc.Models.EditPetViewModel
@using Models.Interfaces
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Edit pet";
}

<div class="container px-4 py-4" id="edit-pet">
    <h2 class="pb-2 border-bottom">Edit pet</h2>

    <form method="post" novalidate>
        <div class="row g-3">
            <div class="col-12">
                <div asp-validation-summary="All" class="text-danger"></div>
            </div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FriendId" />

            <div class="col-md-6">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.Kind" class="form-label"></label>
                <select asp-for="Input.Kind" class="form-select" asp-items="Html.GetEnumSelectList<AnimalKind>()"></select>
                <span asp-validation-for="Input.Kind" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Input.Mood" class="form-label"></label>
                <select asp-for="Input.Mood" class="form-select" asp-items="Html.GetEnumSelectList<AnimalMood>()"></select>
                <span asp-validation-for="Input.Mood" class="text-danger"></span>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-success btn-sm">Save</button>
                <a class="btn btn-outline-secondary btn-sm ms-2" asp-controller="Friend" asp-action="ViewFriend" asp-route-id="@Model.FriendId">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
