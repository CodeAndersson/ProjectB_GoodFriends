@model AppMvc.Models.EditQuoteViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Edit quote";
}

<div class="container px-4 py-4" id="edit-quote">
    <h2 class="pb-2 border-bottom">Edit quote</h2>

    <form method="post" novalidate>
        <div class="row g-3">
            <div class="col-12">
                <div asp-validation-summary="All" class="text-danger"></div>
            </div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="FriendId" />

            <div class="col-md-8">
                <label asp-for="Input.Quote" class="form-label"></label>
                <input asp-for="Input.Quote" class="form-control" />
                <span asp-validation-for="Input.Quote" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Input.Author" class="form-label"></label>
                <input asp-for="Input.Author" class="form-control" />
                <span asp-validation-for="Input.Author" class="text-danger"></span>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-success btn-sm">Save</button>
                <a class="btn btn-outline-secondary btn-sm ms-2" asp-controller="Friend" asp-action="ViewFriend" asp-route-id="@Model.FriendId">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
