@page
@model AppRazor.Pages.CreateQuoteModel
@{
    ViewData["Title"] = "Add quote";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]

<div class="container px-4 py-4" id="create-quote">
    <h2 class="pb-2 border-bottom">Add quote</h2>

    <form class="needs-validation" method="post" novalidate>
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Quote</label>
                <input asp-for="Input.Quote" class="form-control" />
                <span asp-validation-for="Input.Quote" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">Author</label>
                <input asp-for="Input.Author" class="form-control" />
                <span asp-validation-for="Input.Author" class="text-danger"></span>
            </div>
        </div>

        <button class="btn btn-primary btn-lg my-4" type="submit">Save</button>
        <a class="btn btn-secondary btn-lg my-4" href="~/Members/ViewFriend?id=@Model.FriendId">Cancel</a>
    </form>
</div>

@section script
{
    <partial name="_ValidationScriptsPartial" />
}
