@page
@model AppRazor.Pages.EditAddressModel
@{
    ViewData["Title"] = "Edit address";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]

<!-- Page Edit address -->
<div class="container px-4 py-4" id="edit-address">
    <h2 class="pb-2 border-bottom">Edit address</h2>

    <form class="needs-validation" method="post" novalidate>
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">Street address</label>
                <input asp-for="Input.StreetAddress" class="form-control" />
                <span asp-validation-for="Input.StreetAddress" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label class="form-label">Zip code</label>
                <input asp-for="Input.ZipCode" class="form-control" />
                <span asp-validation-for="Input.ZipCode" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">City</label>
                <input asp-for="Input.City" class="form-control" />
                <span asp-validation-for="Input.City" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Country</label>
                <input asp-for="Input.Country" class="form-control" />
                <span asp-validation-for="Input.Country" class="text-danger"></span>
            </div>
        </div>

        <button class="btn btn-primary btn-lg my-4" type="submit">Save</button>
        @if (Model.FriendId != Guid.Empty)
        {
            <a class="btn btn-secondary btn-lg my-4" href="~/Members/ViewFriend?id=@Model.FriendId">Cancel</a>
        }
        else
        {
            <a class="btn btn-secondary btn-lg my-4" href="~/Members/ListOfFriends">Cancel</a>
        }
    </form>
</div>

@section script
{
    <partial name="_ValidationScriptsPartial" />
}
