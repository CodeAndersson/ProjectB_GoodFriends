@page
@model AppRazor.Pages.ListOfFriendsModel
@using Microsoft.AspNetCore.Authorization;
@using Models.Authorization;
@inject IAuthorizationService _authService;

@{
    ViewData["Title"] = "List friends";
    var hasActions = false;
    if (Model.Friends is not null)
    {
        foreach (var f in Model.Friends)
        {
            if ((await _authService.AuthorizeAsync(User, f, CrudOperations.Edit)).Succeeded
                || (await _authService.AuthorizeAsync(User, f, CrudOperations.Delete)).Succeeded)
            {
                hasActions = true;
                break;
            }
        }
    }
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@attribute [IgnoreAntiforgeryToken]

<!-- Page List of friends -->
<div class="container px-4 py-4" id="list-of-friends">
    <h2 class="pb-2 border-bottom">List of Friends</h2>

    <p>The data source contains @Model.NrOfFriends friends with the search criteria</p>

    <form method="post" class="needs-validation" novalidate>
        <label class="form-check-label" for="useSeeds">Use seeded data</label>
        <input asp-for="UseSeeds" class="form-check-input" type="checkbox" id="useSeeds">

        <div class="row row-cols-1 row-cols-lg-4 align-items-stretch g-4 py-5">
            <div class="col-md-7 col-lg-10">
                <div class="row mb-2 text-center">
                    <!-- Search filter-->
                    <div class="row mb-2 text-center">
                        <div class="col-md-6 ">
                            <input asp-for="SearchFilter" class="form-control" type="search" placeholder="Search (name, email, city, country...)" aria-label="Search">
                        </div>
                        <div class="col-md-2 ">
                            <button asp-page-handler="Search" class="btn btn-outline-success" type="submit">Search</button>
                        </div>
                    </div>
                </div>

                <div class="row mb-2 text-center">
                    <!-- This is where selected item id will be stored -->
                    <input type="hidden" name="friendId" data-seido-selected-item-id-target />

                    <div class="@(hasActions?"col-md-10": "col-md-12") themed-grid-head-col">Friend</div>
                    @if (hasActions)
                    {
                        <div class="col-md-2 themed-grid-head-col">Actions</div>
                    }
                </div>

                <div class="row mb-2 text-center">
                    @if (Model.Friends is not null)
                    {
                        @foreach (var item in Model.Friends)
                        {
                            var canEdit = (await _authService.AuthorizeAsync(User, item, CrudOperations.Edit)).Succeeded;
                            var canDelete = (await _authService.AuthorizeAsync(User, item, CrudOperations.Delete)).Succeeded;

                            <div class="@(hasActions?"col-md-10": "col-md-12") themed-grid-col">
                                <a href="~/Members/ViewFriend?id=@item.FriendId">
                                    @item.FirstName @item.LastName
                                    @if (!string.IsNullOrWhiteSpace(item.Address?.City) || !string.IsNullOrWhiteSpace(item.Address?.Country))
                                    {
                                        <span> (@item.Address?.City / @item.Address?.Country)</span>
                                    }
                                </a>
                            </div>
                            @if (hasActions)
                            {
                                <div class="col-md-2 themed-grid-col">
                                    @if (canEdit)
                                    {
                                        <a href="~/Members/EditFriend?id=@item.FriendId" class="btn btn-secondary btn-sm m-1" type="button">Edit</a>
                                    }

                                    @if (canDelete)
                                    {
                                        <!-- Button to trigger modal confirmation with modal in the form tag -->
                                        <button type="button" class="btn btn-danger btn-sm m-1" data-bs-toggle="modal" data-bs-target="#delModal"
                                                data-seido-modal-body="@item.FirstName @item.LastName is about to be deleted."
                                                data-seido-selected-item-id="@item.FriendId">
                                            Del
                                        </button>
                                    }
                                </div>
                            }
                        }

                        <nav aria-label="Standard pagination example">
                            <ul class="pagination">
                                <li class="page-item">
                                    <a class="page-link" href="~/Members/ListOfFriends?pagenr=@Model.PrevPageNr&search=@Model.SearchFilter&useSeeds=@Model.UseSeeds" aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                                @for (int i = 0; i < Model.NrVisiblePages; i++)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="~/Members/ListOfFriends?pagenr=@i&search=@Model.SearchFilter&useSeeds=@Model.UseSeeds">@(i + 1)</a>
                                    </li>
                                }
                                <li class="page-item">
                                    <a class="page-link" href="~/Members/ListOfFriends?pagenr=@Model.NextPageNr&search=@Model.SearchFilter&useSeeds=@Model.UseSeeds" aria-label="Next">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }

                    <!-- Modal in the form tag -->
                    <div class="modal fade" id="delModal" tabindex="-1" aria-labelledby="softModalLabel" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title text-danger" id="softModalLabel">Confirm deletion</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    Hello from modal
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" asp-page-handler="DeleteFriend" class="btn btn-primary btn-danger">Ok</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
